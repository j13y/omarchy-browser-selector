#!/bin/bash
# The whole point of this plugin: registered as the default handler for
# x-scheme-handler/http and /https (see browser-selector-install), so this
# is what actually runs whenever any app opens a link. Figures out which
# browser should handle it and hands it off, then gets out of the way.
set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh
source "$SELF_DIR/lib.sh"

# We are registered for x-scheme-handler/http(s), but we are not only ever
# handed a bare URL. Anything that resolves "the default browser" and then
# probes or drives it hands us argv meant for a real browser instead —
# omarchy-launch-browser is the one that bites here: because xdg-settings
# now reports *us* as the default browser, it runs `<us> --help` to sniff
# which browser family it is talking to, and then re-invokes us with the
# URL. Treating $1 as the URL unconditionally meant that --help probe got
# forwarded to a real browser as if it were a link, so a single click
# opened an extra browser window (and `--private <url>` opened a window for
# the flag and dropped the URL entirely). Take the first genuine http(s)
# argument as the URL and ignore everything else.
url="" want_private=0
for arg in "$@"; do
  case "$arg" in
    http://* | https://*) [[ -z $url ]] && url="$arg" ;;
    # Private-window intent, in whichever spelling the caller guessed at.
    # Normalised here and translated to the right flag for whichever
    # browser we actually resolve, rather than forwarded verbatim.
    --private | --private-window | --incognito | --inprivate) want_private=1 ;;
    *) log "dispatch: ignoring non-URL argument '$arg'" ;;
  esac
done

if [[ -z $url ]]; then
  log "dispatch: invoked with no http(s) URL (args: $*), nothing to do"
  exit 0
fi

ensure_config
cfg="$(read_config)"
[[ -n $cfg ]] || cfg="{}"

enabled=$(jq -r 'if (.enabled | type) == "boolean" then .enabled else true end' <<<"$cfg")
default_browser=$(jq -r '.default // empty' <<<"$cfg")

target="" reason="" class="" initial="" title=""

if [[ $enabled != "true" ]]; then
  reason="routing paused"
  target="$default_browser"
else
  mapfile -t win < <(get_active_window)
  class="${win[0]:-}"; initial="${win[1]:-}"; title="${win[2]:-}"

  target=$(match_rule "$cfg" "$class" "$initial" "$title") || target=""
  if [[ -n $target ]]; then
    reason="matched app rule (source '$class'/'$initial')"
  else
    target=$(match_url_rule "$cfg" "$url") || target=""
    if [[ -n $target ]]; then
      reason="matched url rule"
    else
      reason="no rule matched source '$class'/'$initial'"
      target="$default_browser"
    fi
  fi
fi

log "url=$url source_class=$class source_initial=$initial reason=$reason target=${target:-<none>}"
launch_browser "$target" "$url" "$want_private"
