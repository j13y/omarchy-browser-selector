#!/bin/bash
# Flips `enabled` (smart routing on/off) and prints the new value ("true" or
# "false"). When disabled, every link goes to `default` regardless of rules —
# a quick pause, not an uninstall.
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh
source "$SELF_DIR/lib.sh"

ensure_config
cfg="$(read_config)"
[[ -n $cfg ]] || cfg="{}"
tmp="$(mktemp "$CONFIG_DIR/.config.json.XXXXXX")"
jq '.enabled = ((if (.enabled | type) == "boolean" then .enabled else true end) | not)' <<<"$cfg" >"$tmp" && mv "$tmp" "$CONFIG_FILE"

# Read the new value back through read_config rather than `jq ... "$CONFIG_FILE"`
# directly: the mv above is an atomic rename so it can't itself be raced, but a
# plain-pathname read one line later still would be — read_config checks/reads
# through an already-open fd instead (see its comment in lib.sh).
new_cfg="$(read_config)"
[[ -n $new_cfg ]] || new_cfg="{}"
new=$(jq -r '.enabled' <<<"$new_cfg")
log "toggle: enabled=$new"
printf '%s' "$new"
